# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary (image hosting + transforms)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Create an unsigned upload preset in Cloudinary settings so the admin
# dashboard can upload photos straight from the browser.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Resend (transactional email)
# Until a custom domain is connected, use Resend's sandbox sender:
# RESEND_FROM="Her Brand <onboarding@resend.dev>"
RESEND_API_KEY=
RESEND_FROM="Her Brand <onboarding@resend.dev>"

# WhatsApp ordering (no API/token needed, just her number in international format)
NEXT_PUBLIC_WHATSAPP_NUMBER=2348000000000
