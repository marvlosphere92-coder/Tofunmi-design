# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary (image hosting + transforms)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Create an unsigned upload preset in Cloudinary settings so the admin
# dashboard can upload photos straight from the browser.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Resend (transactional email)
# Until a custom domain is connected, use Resend's sandbox sender:
RESEND_API_KEY=
RESEND_FROM="Tofunmi's Fashion Home <onboarding@resend.dev>"

# WhatsApp ordering (no API/token needed, just the business number in international format)
NEXT_PUBLIC_WHATSAPP_NUMBER=2348000000000

# Base site URL, used to build links inside emails (e.g. "manage your order").
# Falls back to Vercel's own VERCEL_URL in production if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact email shown in the site footer
NEXT_PUBLIC_CONTACT_EMAIL=
